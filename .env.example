# ==============================================================================
# ADViora Backend Environment Configuration Template
# ==============================================================================
# NOTE: Never commit .env.local or real credentials to Git.
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# Server-only MongoDB Connection URI
# The URI must include an explicit database path:
# - Production database: adviora_prod
# - Development / Preview / Test database: adviora_dev (or an isolated test DB)
#
# WARNING: Automated write or rollback tests must NEVER be run against production.
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/adviora_prod?retryWrites=true&w=majority
